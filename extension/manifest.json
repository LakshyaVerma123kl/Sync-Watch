{
  "manifest_version": 3,
  "name": "SyncWatch",
  "version": "1.0.0",
  "description": "Watch videos synchronously with friends across the web.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/styles.css"],
      "js": [
        "content/adapters/base.js",
        "content/adapters/generic.js",
        "content/adapters/youtube.js",
        "content/ui.js",
        "content/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SyncWatch"
  }
}
